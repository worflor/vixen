    "vixen-scaled-state.mjs",
    "vixen_scaled_state.py",
    "vixen-exponential.mjs",
    "vixen_exponential.py"
  ],
  "scripts": {
    "test": "node tools/run-js-tests.mjs",
    "test:parity": "python tests/cross_port.py",
    "test:fuzz": "node tests/fuzz.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "test:new": "npm run test:python",
    "test:python": "python -m unittest discover -s tests -p \"test_python*.py\"",
    "test:java": "python tools/test_java.py",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 examples/types.mts",
    "build:instrument": "python tools/build_instrument.py",
    "build:illustration": "node tools/build_illustration.mjs",
    "audit": "node research/run-audit.mjs",
    "test:standalone": "python tools/test_standalone.py"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/worflor/vixen.git"
  },
  "keywords": [
    "deterministic",
    "procedural-generation",
    "trajectory-generation",
    "seeded-randomness",
    "interpolation",
    "numerical-methods",
    "javascript",
    "python"
  ]
}
