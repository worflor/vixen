{
  "name": "@worflor/vixen",
  "version": "1.0.0",
  "description": "Deterministic seeded 16-dimensional game curves with a controllable trajectory backbone.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./vixen.d.ts",
      "import": "./vixen.mjs",
      "default": "./vixen.mjs"
    }
  },
  "types": "./vixen.d.ts",
  "files": [
    "vixen.mjs",
    "vixen.d.ts",
    "vixen.py",
    "instrument/vixen.html",
    "README.md",
    "docs",
    "AGENTS.md",
    "legacy",
    "research/evidence.json",
    "research/verification-game.json",
    "research/rhythm-audit.json",
    "research/stabilizer-audit.json",
    "examples"
  ],
  "scripts": {
    "test": "node --test tests/test-hyperfield.mjs tests/test-kernel.mjs tests/test-stabilizer.mjs tests/test-examples.mjs",
    "test:parity": "python tests/cross_port.py",
    "typecheck": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 examples/types.mts",
    "build:instrument": "python tools/build_instrument.py",
    "build:illustration": "node tools/build_illustration.mjs",
    "audit": "node research/run-audit.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/worflor/vixen.git"
  }
}
