{
  "name": "@worflor/vixen",
  "version": "1.5.0",
  "description": "Deterministic progression fields with replayable composition in JavaScript, Python and Java; no runtime dependencies.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./vixen.d.ts",
      "import": "./vixen.mjs",
      "default": "./vixen.mjs"
    }
  },
  "types": "./vixen.d.ts",
  "files": [
    "vixen_operations.py",
    "vixen_influence_calculus.py",
    "vixen_operation_calculus.py",
    "vixen_jet_composition.py",
    "vixen_calculus.py",
    "vixen_api.py",
    "vixen_analysis.py",
    "vixen_timeline.py",
    "vixen_checkpoint.py",
    "vixen_guide.py",
    "vixen_influence.py",
    "vixen.d.ts",
    "vixen.py",
    "instrument/vixen.html",
    "README.md",
    "docs",
    "AGENTS.md",
    "legacy",
    "research/constraints-evidence.json",
    "research/hardening-evidence.json",
    "research/influence-evidence.json",
    "research/influence-parity.json",
    "research/proofs",
    "research/benchmarks.json",
    "research/timelines-evidence.json",
    "research/evidence.json",
    "research/verification-game.json",
    "research/rhythm-audit.json",
    "research/stabilizer-audit.json",
    "examples",
    "vixen-analysis.mjs",
    "vixen-api.mjs",
    "vixen-calculus.mjs",
    "vixen-checkpoint.mjs",
    "vixen-correlation.mjs",
    "vixen-guide.mjs",
    "vixen-influence.mjs",
    "vixen-interval.mjs",
    "vixen-jet-composition.mjs",
    "vixen-operations.mjs",
    "vixen-timeline.mjs",
    "vixen.mjs",
    "vixen-float.mjs",
    "vixen_correlation.py",
    "vixen_float.py",
    "vixen_interval.py",
    "vixen-wide.mjs",
    "vixen_wide.py",
    "research/additive-influence.md",
    "research/additive-components.json",
    "research/numeric-components.json",
    "research/analytic-kernel-components.json",
    "research/native-baseline-positivity.md",
    "research/redistribution-components.json",
    "vixen-influence-calculus.mjs",
    "vixen-operation-calculus.mjs",
    "vixen-extended-operations.mjs",
    "vixen-extended-coupling.mjs",
